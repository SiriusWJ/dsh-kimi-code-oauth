{
  "name": "dsh-kimi-code-oauth",
  "version": "0.1.3",
  "description": "DeepSeek Harness plugin for Kimi Code subscription OAuth",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": { "dsh-kimi-code": "lib/bin.js" },
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" }, "./client": "./client/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib", "client", "cordis.patch.yml", "README.md", "LICENSE"],
  "readme": "README.md",
  "scripts": { "typecheck": "tsc -p tsconfig.json", "build": "pnpm run typecheck", "test": "vitest run" },
  "engines": { "node": ">=22.19.0", "dsh": ">=0.1.5-rc.1 <0.3.0" },
  "repository": { "type": "git", "url": "git+https://github.com/SiriusWJ/dsh-kimi-code-oauth.git" },
  "homepage": "https://github.com/SiriusWJ/dsh-kimi-code-oauth#readme",
  "bugs": { "url": "https://github.com/SiriusWJ/dsh-kimi-code-oauth/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "kimi-code", "oauth", "subscription", "device-code" ],
  "dsh": { "engines": { "dsh": ">=0.1.5-rc.1 <0.3.0" }, "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"] } },
  "dependencies": { "undici": "7.29.0" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.2.0-rc.1", "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.2.0-rc.1", "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.2.0-rc.1", "@deepseek-ai/schemastery": "^3.18.1", "@earendil-works/pi-ai": "0.84.2" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "@deepseek-ai/dsh-home-paths": { "optional": true }, "@deepseek-ai/dsh-llm": { "optional": true }, "@deepseek-ai/dsh-llm-pi-ai": { "optional": true }, "@deepseek-ai/schemastery": { "optional": true }, "@earendil-works/pi-ai": { "optional": true } },
  "devDependencies": { "@types/node": "^22.20.0", "typescript": "^6.0.3", "vitest": "^4.1.8", "@deepseek-ai/cordis": "4.0.1", "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2", "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2", "@deepseek-ai/dsh-llm": "0.1.1-rc.2",  "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2", "@deepseek-ai/dsh-attachment": "0.1.1-rc.2", "@earendil-works/pi-ai": "0.84.2" }
}
